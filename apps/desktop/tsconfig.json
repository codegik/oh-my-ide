{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    // The renderer is browser code; main/preload are Node. One project covers
    // both, so it needs both libs. DOM.Iterable is what makes NodeList iterable.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"]
}
