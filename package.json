{
  "name": "oh-my-ide",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "dev": "pnpm --filter @omi/desktop dev",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify:abi": "node tools/scripts/verify-abi.mjs",
    "pretest": "pnpm verify:abi",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3 -m apps/daemon || echo '[warn] electron-rebuild failed — run pnpm verify:abi'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@electron/rebuild": "^4.0.1",
    "electron": "44.4.1",
    "node-gyp": "^11.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
